# Copy to deploy/.env and set API_AUTH_TOKEN before starting the stack.
#
# Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# It has to be set here rather than left to the backend's own generation,
# because the frontend image is built with the same value baked in -- the
# two sides have to agree at build time.
API_AUTH_TOKEN=

# The URL a browser will use to reach the API. Compiled into the frontend
# bundle, so it must be reachable from the user's machine -- "http://backend"
# resolves only inside the compose network and will not work here.
PUBLIC_API_URL=http://localhost:8000

# Must match the origin the UI is served from, or the browser blocks the calls.
FRONTEND_ORIGIN=http://localhost:3000

BACKEND_PORT=8000
FRONTEND_PORT=3000

# Absolute host path holding the repositories the agent may work on. It sees
# nothing outside this, so it is also the limit of what it can touch.
#
# Absolute and identical inside the container, because with SANDBOX_BACKEND=
# docker the host daemon resolves the sandbox's mount path in its own
# filesystem. A mismatch does not error -- it mounts an empty directory, and
# the run reports "no tests" instead of failing.
REPOS_DIR=/srv/ai-softeng-repos

LLM_MODEL=qwen2.5-coder:7b
EMBEDDING_MODEL=nomic-embed-text

# docker gives each command its own throwaway container (needs the socket
# mount, and a Linux host -- see REPOS_DIR). subprocess runs them inside the
# backend container instead: no socket, no path translation, but an
# agent-authored command then shares a filesystem with the database and the
# auth token. Use subprocess on Docker Desktop for Windows or macOS.
SANDBOX_BACKEND=docker
SANDBOX_DOCKER_MEMORY_LIMIT=512m
SANDBOX_DOCKER_CPU_LIMIT=1.0

# Embedding a large repository is one long request; the default 120s is not
# enough for the first index of anything substantial.
LLM_REQUEST_TIMEOUT_SECONDS=1800
