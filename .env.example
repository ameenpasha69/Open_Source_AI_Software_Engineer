# --- App ---
APP_NAME=local-ai-software-engineer
LOG_LEVEL=INFO
# "text" for a human-readable console; "json" for one-object-per-line structured logs
LOG_FORMAT=text
DATA_DIR=./data

# --- Authentication ---
# This API runs commands and writes files, so it is authenticated by default.
# Leave API_AUTH_TOKEN blank and a token is generated on first start, logged,
# and kept in $DATA_DIR/auth_token. Set it to pin a known value instead.
# The frontend reads the same value from NEXT_PUBLIC_API_AUTH_TOKEN.
#
# AUTH_ENABLED=false turns it off. Only do that behind something else that
# authenticates -- an unauthenticated instance is remote code execution for
# anything that can reach it.
AUTH_ENABLED=true
API_AUTH_TOKEN=

# --- LLM provider (must run 100% locally) ---
# Supported: ollama
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:7b
LLM_BASE_URL=http://localhost:11434
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_DEFAULT_TEMPERATURE=0.2

# --- Embedding provider ---
# Supported: ollama
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434

# --- Agent ---
MAX_AGENT_ITERATIONS=8

# --- Sandboxing ---
# "subprocess" (default, no extra setup) or "docker" (real network/filesystem
# isolation + memory/CPU limits — needs Docker and the image built by
# `docker build -f docker/sandbox.Dockerfile -t local-ai-softeng-sandbox .`,
# which scripts/setup.sh does automatically if Docker is available).
SANDBOX_BACKEND=subprocess
SANDBOX_DOCKER_IMAGE=local-ai-softeng-sandbox:latest
SANDBOX_DOCKER_MEMORY_LIMIT=512m
SANDBOX_DOCKER_CPU_LIMIT=1.0
